{
  "name": "pi-event-search",
  "version": "0.0.1",
  "type": "module",
  "description": "Event-oriented cross-session history retrieval for the Pi coding agent",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "session-search",
    "event-search"
  ],
  "author": "Zihan Wang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MacroSony/pi-event-search.git"
  },
  "homepage": "https://github.com/MacroSony/pi-event-search#readme",
  "bugs": {
    "url": "https://github.com/MacroSony/pi-event-search/issues"
  },
  "files": [
    "LICENSE",
    "extension.ts",
    "src",
    "docs",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extension.ts"
    ]
  },
  "scripts": {
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "test:single": "node --test --experimental-strip-types",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run check"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@types/node": "^26.2.0",
    "typebox": "^1.3.14",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  }
}
